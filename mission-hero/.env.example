# --- Database -------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mission_hero?schema=public"
# Used by the integration test project only.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mission_hero_test?schema=public"

# --- Auth -----------------------------------------------------------------
# Must be at least 32 characters. Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# --- App ------------------------------------------------------------------
NODE_ENV="development"
APP_URL="http://localhost:3000"
# Master switch for photo/voice evidence. Families can still opt out individually.
MEDIA_UPLOADS_ENABLED="false"
